<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/title" android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/explanation"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/full_level_label"
            android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
        <RadioGroup android:id="@+id/full_level_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/full_80" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/full_80" />
            <RadioButton android:id="@+id/full_85" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/full_85" />
            <RadioButton android:id="@+id/full_90" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/full_90" />
        </RadioGroup>
        <TextView android:id="@+id/framework_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="@string/framework_unavailable"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
